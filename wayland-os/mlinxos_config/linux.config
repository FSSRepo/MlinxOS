CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
# The signed regulatory database needs the host's OpenSSL headers to build the kernel certs.
# CERTIFICATION_ONUS (which needs EXPERT) makes the option below configurable; otherwise it is forced on.
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set
# CONFIG_CFG80211_CRDA_SUPPORT is not set
# Live system: the root filesystem is a squashfs read from the medium, with an overlay on top (no RAM copy).
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
